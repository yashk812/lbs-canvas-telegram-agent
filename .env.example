# Copy this file to .env and fill in your own values.
# .env is gitignored — NEVER commit real tokens. In GitHub Actions these go in
# Settings -> Secrets and variables -> Actions (not in the code).

# --- Canvas (LBS) — required for assignments, prep and seating -------------
# Host is learning.london.edu for LBS. Token: Canvas -> Account -> Settings ->
# "+ New Access Token". Treat it like a password.
CANVAS_BASE_URL=https://learning.london.edu
CANVAS_TOKEN=your_canvas_access_token

# --- LBS Live Calendar (iCal) — required for your class/event schedule -----
# From the LBS calendar site's "Subscribe" link (a personal, secret URL).
LBS_CALENDAR_URL=https://lbscalendar.london.edu/api/student/subscription/xxxxxxxx

# --- Telegram — required for delivery --------------------------------------
# Bot token from @BotFather. Chat id: message your bot once, then run
# `python scripts/get_chat_id.py`.
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Personal Google Calendar (iCal) — optional ----------------------------
# Google Calendar -> Settings and sharing -> Integrate calendar ->
# "Secret address in iCal format" (the private-... one, NOT public).
GOOGLE_CALENDAR_URL=

# --- Seating charts (LBS MBA cohorts only) — optional ----------------------
# Set your stream to get per-room seating-chart links (e.g. "Stream C").
# Leave blank to turn the feature off. The cohort course is auto-detected;
# override only if needed. Update SEATING_TERM_SECTION as the year advances.
SEATING_STREAM=
# SEATING_COURSE_ID=
# SEATING_TERM_SECTION=Term 1, Part 1

# --- Misc -------------------------------------------------------------------
TIMEZONE=Europe/London
# WEATHER_LAT=51.5238
# WEATHER_LON=-0.1585
